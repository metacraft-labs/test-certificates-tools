{
  description = "Reference helper tooling for the test-certificate standard";

  inputs = {
    nixos-modules.url = "github:metacraft-labs/devops-modules";
    nixpkgs.follows = "nixos-modules/nixpkgs-unstable";
    flake-parts.follows = "nixos-modules/flake-parts";
    git-hooks.follows = "nixos-modules/git-hooks-nix";
  };

  outputs =
    inputs@{ flake-parts, nixos-modules, ... }:
    flake-parts.lib.mkFlake { inherit inputs; } {
      imports = [
        nixos-modules.modules.flake.git-hooks
      ];

      systems = [
        "x86_64-linux"
        "aarch64-linux"
        "x86_64-darwin"
        "aarch64-darwin"
      ];

      perSystem =
        { pkgs, config, ... }:
        let
          # Single-sourced from the nimble file: this package has exactly one
          # version, and a second copy of it is a thing that can drift.
          nimbleVersionLines = builtins.filter (line: builtins.match "version[[:space:]]*=.*" line != null) (
            pkgs.lib.splitString "\n" (builtins.readFile ./test_certificates.nimble)
          );
          version = builtins.elemAt (builtins.match "version[[:space:]]*=[[:space:]]*\"([^\"]+)\".*" (builtins.head nimbleVersionLines)) 0;
          # git-hooks.nix installs its hooks into `git rev-parse --show-toplevel`
          # of the directory the shell is entered from, so `nix develop
          # /path/to/this-repo` run inside another checkout would plant this
          # repository's hooks there. `ownRepoOnly` runs a snippet only when that
          # toplevel is this repository, recognised by a `flake.nix` identical to
          # the one this shell was evaluated from; anything it cannot establish
          # counts as another repository, so it fails safe.
          ownRepoOnly = script: ''
            _own_repo_root="$(${pkgs.git}/bin/git rev-parse --show-toplevel 2>/dev/null || true)"
            if [ -n "$_own_repo_root" ] && [ -f "$_own_repo_root/flake.nix" ] \
              && [ "$(${pkgs.coreutils}/bin/sha256sum "$_own_repo_root/flake.nix" | ${pkgs.coreutils}/bin/cut -d' ' -f1)" \
                = "${builtins.hashFile "sha256" ./flake.nix}" ]; then
            ${script}
            # git-hooks.nix's installer leaves core.hooksPath as the RELATIVE
            # `.git/hooks`, which a linked worktree cannot resolve (there `.git`
            # is a file), so git would silently run no hooks there. Point it at
            # the common hooks directory instead.
            if [ "$(${pkgs.git}/bin/git config --local --get core.hooksPath 2>/dev/null)" = .git/hooks ]; then
              ${pkgs.git}/bin/git config --local core.hooksPath "$(${pkgs.git}/bin/git rev-parse --path-format=absolute --git-common-dir)/hooks"
            fi
            # The installer moves a Reprobuild hook dispatcher aside to
            # `<hook>.legacy` and puts pre-commit's shim in its slot. Put the
            # dispatcher back and chain the shim as `<hook>.repro-local`, which the
            # dispatcher runs: the layout `repro hooks ensure --vcs` produces.
            _hooks="$(${pkgs.git}/bin/git rev-parse --path-format=absolute --git-path hooks 2>/dev/null || true)"
            for _legacy in "$_hooks"/*.legacy; do
              [ -f "$_legacy" ] && grep -q 'reprobuild hook dispatcher' "$_legacy" || continue
              _slot="''${_legacy%.legacy}"
              if [ -f "$_slot" ] && grep -q 'reprobuild hook dispatcher' "$_slot"; then
                rm -f "$_legacy"
              elif [ ! -e "$_slot" ] || grep -Eq '^# File generated by (pre-commit|prek)' "$_slot"; then
                if [ -f "$_slot.repro-local" ] && ! grep -Eq '^# File generated by (pre-commit|prek)' "$_slot.repro-local"; then
                  echo "git-hooks: $_slot.repro-local is your own hook; run 'repro hooks ensure --vcs' to reconcile." >&2
                  continue
                fi
                if [ -e "$_slot" ]; then mv -f "$_slot" "$_slot.repro-local"; fi
                mv -f "$_legacy" "$_slot"
              else
                echo "git-hooks: $_slot is not a pre-commit shim; run 'repro hooks ensure --vcs' to reconcile." >&2
              fi
            done
            unset _hooks _legacy _slot
            fi
            unset _own_repo_root
          '';
        in
        {
          pre-commit.settings.hooks = {
            nixfmt.enable = true;
            check-license = {
              enable = true;
              name = "Check License File";
              entry = "bash -c 'if [ ! -f LICENSE ] && [ ! -f LICENSE-APACHE ] && [ ! -f LICENSE-MIT ]; then echo \"Error: No license file (LICENSE, LICENSE-APACHE, LICENSE-MIT) found in repository root!\"; exit 1; fi'";
              files = "^$";
              pass_filenames = false;
            };
            lint = {
              enable = true;
              name = "just lint";
              entry = "just lint";
              files = "\\.(nim|nims|nimble|nix)$";
              pass_filenames = false;
            };
          };

          packages.default = config.packages.test-certificates;

          packages.test-certificates = pkgs.stdenv.mkDerivation {
            pname = "test-certificates";
            inherit version;
            src = ./.;

            nativeBuildInputs = [ pkgs.nim2 ];

            # The library has no dependency beyond the Nim standard library, so
            # this is one compile. `--nimcache` is passed explicitly because
            # config.nims would otherwise place it inside the (read-only)
            # source tree.
            buildPhase = ''
              runHook preBuild
              export HOME="$TMPDIR"
              nim c -d:release --hints:off --nimcache:"$TMPDIR/nimcache" \
                -o:build/bin/test-certificates src/test_certificates_cli.nim
              runHook postBuild
            '';

            installPhase = ''
              runHook preInstall
              install -Dm755 build/bin/test-certificates "$out/bin/test-certificates"
              mkdir -p "$out/src"
              cp -r src/. "$out/src/"
              install -Dm644 test_certificates.nimble "$out/test_certificates.nimble"
              install -Dm644 LICENSE "$out/share/doc/test-certificates/LICENSE"
              install -Dm644 NOTICE "$out/share/doc/test-certificates/NOTICE"
              runHook postInstall
            '';

            meta = {
              description = "Reference helper tooling for the test-certificate standard";
              homepage = "https://github.com/metacraft-labs/test-certificates-tools";
              license = pkgs.lib.licenses.asl20;
              mainProgram = "test-certificates";
            };
          };

          # `nix run github:metacraft-labs/test-certificates-tools -- <args>`.
          apps.default = {
            type = "app";
            program = pkgs.lib.getExe config.packages.test-certificates;
            meta.description = "Run the test-certificates command";
          };

          # `nix flake check` builds the package. Lint and tests need the sibling
          # specification checkout and run through `just`, not as flake checks.
          checks.package-build = config.packages.test-certificates;

          # The release workflow (.github/workflows/release.yml) runs
          # scripts/release/build.sh in this shell: the compiler, Node for the
          # shared release tooling, and on Linux zig (a glibc 2.28 sysroot) and
          # the ELF, .deb and .rpm packagers.
          devShells.release = pkgs.mkShell {
            packages = [
              pkgs.nodejs
              pkgs.nim2
            ]
            ++ pkgs.lib.optionals pkgs.stdenv.isLinux [
              pkgs.zig
              pkgs.patchelf
              pkgs.binutils
              pkgs.dpkg
              pkgs.rpm
            ];
          };

          devShells.default = pkgs.mkShell {
            # Not `inputsFrom = [ config.pre-commit.devShell ]`: that shell's
            # hook installs the git hooks without `ownRepoOnly`.
            shellHook = ownRepoOnly config.pre-commit.installationScript;
            packages = [
              pkgs.just
              pkgs.nim2
              pkgs.nimble
              pkgs.nph
              pkgs.git
              pkgs.openssh
              pkgs.coreutils
              pkgs.nixfmt
            ]
            ++ pkgs.lib.optionals pkgs.stdenv.isLinux [ pkgs.acl ]
            ++ config.pre-commit.settings.enabledPackages
            ++ [ config.pre-commit.settings.package ];
          };
        };
    };
}
