# Build outputs (`just build`, `just build-tests`).
/build/
# Per-checkout nimcache (config.nims): every Nim compile in this checkout
# keeps its intermediate files here, never in the shared ~/.cache/nim.
.nimcache/
nimcache/
*.exe

# Reprobuild development environment cache
.repro/

# direnv
.direnv/

# Generated by the flake's pre-commit integration.
.pre-commit-config.yaml

# CI-only checkout of the specification (.github/workflows/ci.yml).
/.ci/

# Release workflow outputs (scripts/release/build.sh, run by the shared
# release tooling).
/dist/
/test-logs/
